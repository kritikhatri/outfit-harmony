{
  "name": "outfit-harmony",
  "version": "0.1.1",
  "description": "Check whether outfit colours go together and get matching suggestions - colour theory with fashion-aware neutrals (navy, denim, camel, cream...). Zero dependencies.",
  "type": "module",
  "main": "./src/index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./src/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "outfit-harmony": "bin/cli.js"
  },
  "files": [
    "src",
    "bin",
    "index.d.ts"
  ],
  "scripts": {
    "test": "node --test",
    "example": "node examples/basic.js"
  },
  "engines": {
    "node": ">=18.3"
  },
  "keywords": [
    "fashion",
    "outfit",
    "wardrobe",
    "colour",
    "color",
    "color-harmony",
    "color-theory",
    "palette",
    "clothing"
  ],
  "author": "Kritika Khatri",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kritikhatri/outfit-harmony.git"
  },
  "bugs": {
    "url": "https://github.com/kritikhatri/outfit-harmony/issues"
  },
  "homepage": "https://github.com/kritikhatri/outfit-harmony#readme"
}
